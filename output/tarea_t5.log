. levelsof sector, local(sectores)
`"Agricultura"' `"Comercio"' `"Construcción"' `"Educación"' `"Industria"' `"Serv
> icios"'

. local k : word count `sectores'

. matrix R = J(`k', 3, .)

. local i = 1

. foreach s of local sectores {
  2.     quietly regress ingreso educ if sector == "`s'"
  3.     matrix R[`i', 1] = _b[educ]
  4.     matrix R[`i', 2] = _se[educ]
  5.     matrix R[`i', 3] = e(N)
  6.     local i = `i' + 1
  7. }

. 
. matrix colnames R = beta_educ ee n

. matrix rownames R = `sectores'

. matrix list R, format(%9.0f)

